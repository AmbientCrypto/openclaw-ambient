{
  "name": "@ambientcrypto/openclaw",
  "version": "0.1.0",
  "description": "Ambient inference provider for OpenClaw",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmbientCrypto/openclaw-ambient.git"
  },
  "files": [
    "index.ts",
    "openclaw.plugin.json",
    "README.md"
  ],
  "openclaw": {
    "extensions": ["./index.ts"],
